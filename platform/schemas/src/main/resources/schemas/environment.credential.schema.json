{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rail8:schema:environment.credential:1",
  "title": "Rail8 credential of an environment, schemaVersion 1",
  "description": "One credential of a calling system in an environment's configuration, as its export writes it and its import reads it, in a folder that is not a package, at credential/<key>.yaml. Its key is the system's key and one more segment, the credential's name. A basic credential names a user and its password as secret://<name> of a verifier; an api-key credential names its key as secret://<name> of a verifier. It holds references to secrets, never a value, and no state: no revision, version, token, date, author or draft. The types certificate and oauth2 are of this format, and a node refuses them until it checks them.",
  "type": "object",
  "required": ["schemaVersion", "kind", "key", "type"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "environment.credential" },
    "key": { "type": "string", "minLength": 1, "maxLength": 194 },
    "type": { "enum": ["basic", "api-key", "certificate", "oauth2"] },
    "user": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^:\\u0000-\\u001f\\u007f]+$" },
    "password": { "$ref": "#/$defs/secret" },
    "apiKey": { "$ref": "#/$defs/secret" },
    "pinned": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "client": { "type": "string", "minLength": 1, "maxLength": 256 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "basic" } } },
      "then": { "required": ["user", "password"], "propertyNames": { "enum": ["schemaVersion", "kind", "key", "type", "user", "password"] } }
    },
    {
      "if": { "properties": { "type": { "const": "api-key" } } },
      "then": { "required": ["apiKey"], "propertyNames": { "enum": ["schemaVersion", "kind", "key", "type", "apiKey"] } }
    },
    {
      "if": { "properties": { "type": { "const": "certificate" } } },
      "then": { "propertyNames": { "enum": ["schemaVersion", "kind", "key", "type", "pinned", "issuer", "subject"] } }
    },
    {
      "if": { "properties": { "type": { "const": "oauth2" } } },
      "then": { "required": ["issuer", "client"], "propertyNames": { "enum": ["schemaVersion", "kind", "key", "type", "issuer", "client"] } }
    }
  ],
  "$defs": {
    "secret": { "type": "string", "pattern": "^secret://[a-z0-9][a-z0-9._-]{0,127}$" }
  }
}
