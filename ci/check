#!/usr/bin/env bash
# ci/check: the checks of one area, the same commands the workflows under .github/workflows run on GitHub, which call this
# script for each of their jobs. A session runs it before a merge, a workflow on GitHub after one.
#
#   ci/check <area> [arguments]      ci/check help lists the areas
#   ci/check <area> <area>...        each area in turn, every one run even after one failed
#
# Every area runs as a GitHub runner does: TZ=UTC; git without the machine's own settings (no identity, no signing); no
# _JAVA_OPTIONS (its flags are added to JAVA_TOOL_OPTIONS); the JDK of .java-version and the Node.js major of .nvmrc,
# which the workflows install, or it stops before it starts. Where an area needs Docker it starts dockerd when it is
# not running and it can (a session's container runs as root). The Docker areas start the quickstart's containers and
# volumes afresh and take over ~/rail8-workspace and ~/acme-adapter, as on a fresh runner: run them where those can be
# lost, such as a session's container.
#
# Exits 0 when every check of the area passed, 1 when one failed, 2 on a usage error, 3 when the area could not run here
# (a tool missing or of another version, Docker not available); the last line of each area says which. With several
# areas: 1 when one failed, else 3 when one could not run, else 0.
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

usage() {
  cat <<'EOF'
ci/check <area> [arguments] | ci/check <area> <area>...
  guard [<base>]       the script tests under ci/, the change guard against <base> (origin/main by default), the name guard
  platform [<modules>] the platform's build with unit and integration tests (Docker), then the demo package and the sample
                       plugin through bin/rail8; with <modules> (comma-separated, as -pl takes them) only those, the modules
                       that depend on them and what they need, with the mocks, the simulator, the command line and the plugin
  ui                   ui/: licences, generated types, typecheck, lint, unit and browser tests, the production build
  ui-stack             the quickstart's node (Docker) and the UI's @stack scenarios against it
  mapping              mapping/: its script tests, build with tests, licences and bans, the LF checkout check
  jq                   jq/: build with unit and oracle tests, licences, bans and the word check
  stack                deploy/compose (Docker): up, /health, bootstrap, the deploy one-shot, an invoice answered
  quickstart           docs/QUICKSTART.md's commands (Docker): node and UI, the demo deployed, messages found through the UI
  adapter-kit          docs/ADAPTERS.md's commands (Docker): a new adapter built, tested, run with bin/run-adapter, a message found
EOF
}

cannot() { echo "ci/check $area: NOT RUN: $*" >&2; exit 3; }

# A secret of this run: masked in the log on GitHub, never printed here.
mask() { if [ "${GITHUB_ACTIONS:-}" = true ]; then echo "::add-mask::$1"; fi; }

need_java() {
  local want have
  want=$(tr -d '[:space:]' < .java-version)
  have=$(java -XshowSettings:properties -version 2>&1 | sed -n 's/^ *java.specification.version = //p') || true
  [ "$have" = "$want" ] || cannot "Java $want is needed (.java-version), java on the PATH is ${have:-missing}"
}

need_node() {
  local want have
  want=$(tr -d '[:space:]' < .nvmrc)
  have=$(node --version 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/') || true
  [ "$have" = "$want" ] || cannot "Node.js $want is needed (.nvmrc), node on the PATH is ${have:-missing}"
  npm --version > /dev/null 2>&1 || cannot "npm is not installed"
}

need_docker() {
  docker info > /dev/null 2>&1 && return
  command -v dockerd > /dev/null 2>&1 || cannot "Docker is not running and dockerd is not installed"
  [ "$(id -u)" = 0 ] || cannot "Docker is not running and only root can start dockerd"
  local log=${TMPDIR:-/tmp}/rail8-dockerd.log
  echo "ci/check: starting dockerd, its log in $log"
  nohup dockerd > "$log" 2>&1 &
  for _ in $(seq 1 60); do docker info > /dev/null 2>&1 && return; sleep 1; done
  cannot "dockerd did not answer within 60 s: $(tail -3 "$log")"
}

# Chromium for the UI's browser tests, at the build the pinned playwright package names. A machine that sets
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD provides it already, under PLAYWRIGHT_BROWSERS_PATH.
need_chromium() {
  if [ -z "${PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD:-}" ]; then (cd ui && npx playwright install --with-deps chromium); fi
}

mvnw() { ./mvnw -B -ntp "$@"; }

# The node's jar and the command line, as the Docker areas start them.
build_node() { mvnw -q package -DskipTests -pl :rail8-node,:rail8-cli -am; }

# The secret store's key of this run, exported as RAIL8_SECRETS_KEY: the base64 of 256 random bits, made afresh, as
# docs/QUICKSTART.md makes the owner's once.
export_secrets_key() {
  RAIL8_SECRETS_KEY=$(openssl rand -base64 32)
  mask "$RAIL8_SECRETS_KEY"
  export RAIL8_SECRETS_KEY
}

# Starts the quickstart's node (docker-compose.yml) afresh with an emergency key and a secret store's key of this run, waits
# for /health and makes its first users with bootstrap: exports RAIL8_ADMIN_TOKEN (the key), RAIL8_SECRETS_KEY, RAIL8_TOKEN
# (the deploy account's token) and admin_password (the administrator's).
start_quickstart_node() {
  local admin=$1 deploy=$2 key start
  key=$(bin/rail8 key new)
  mask "$key"
  export RAIL8_ADMIN_TOKEN=$key
  export_secrets_key
  docker compose down -v --remove-orphans > /dev/null
  docker compose up -d --build
  start=$(date +%s)
  until curl -sf localhost:8081/health > /dev/null; do
    if [ $(( $(date +%s) - start )) -ge 120 ]; then echo "::error::/health not green within 120 s of up"; return 1; fi
    sleep 2
  done
  admin_password=$(bin/rail8 bootstrap --admin "$admin" --deploy-account "$deploy" --token-file "$tmp/deploy-token")
  mask "$admin_password"
  RAIL8_TOKEN=$(cat "$tmp/deploy-token")
  mask "$RAIL8_TOKEN"
  export RAIL8_TOKEN
}

stop_quickstart_node() {
  if [ "$1" != 0 ]; then docker compose logs --no-color | tail -200 || true; fi
  docker compose down -v > /dev/null
}

# Starts a command in the background in a process group of its own, its output in the file <log>; stopped on exit.
background() {
  local log=$1
  shift
  setsid "$@" > "$log" 2>&1 &
  groups+=("$!")
}

check_guard() {
  python3 -m unittest ci.test_check ci.test_change_guard ci.test_coverage_check ci.test_comment_only_check ci.test_fork_kill_check \
    ci.test_name_guard ci.test_site
  python3 ci/change_guard.py --base "${1:-origin/main}"
  python3 ci/name_guard.py
}

check_platform() {
  need_java
  need_docker
  # -T 1C: modules that do not depend on each other build at the same time; inside a module the test classes are spread
  # over one test JVM per core (rail8.test.forks in platform/pom.xml). rail8.engines.skipTests: the engines' own tests run
  # in the mapping and jq areas. jacoco.skip: coverage is measured only by the coverage job.
  local select=()
  if [ -n "${1:-}" ]; then
    # rail8-component-mock and rail8-sim are needed by rail8-cli and rail8-archtest, which -amd builds but whose own
    # upstream -am leaves out; the command line and the plugin are what the steps below run
    select=(-pl "$1,:rail8-component-mock,:rail8-sim,:rail8-cli,:rail8-plugin-webhook" -am -amd)
  fi
  mvnw -T 1C verify -Pit -Djacoco.skip=true -Drail8.engines.skipTests "${select[@]}"
  bin/rail8 validate examples/demo
  bin/rail8 test examples/demo
  bin/rail8 validate --plugins examples/webhook-plugin/target/plugin examples/webhook-plugin/package
  bin/rail8 test --plugins examples/webhook-plugin/target/plugin examples/webhook-plugin/package
}

check_ui() {
  need_node
  cd ui
  npm ci
  # every npm package carries an allowed licence; a few dev-only build tools are listed as exceptions
  npm run licences
  cd "$root"
  need_chromium
  cd ui
  # the mapping studio's types are generated from the mapping contract and committed; they must match it
  npm run gen:types
  git diff --exit-code src/mapping/generated
  npm run typecheck
  npm run lint
  npm run test
  npm run test:browser
  npm run build
  # the page under e2e/fake/ serves the end-to-end scenarios on the development server only
  test ! -e dist/e2e
  ! grep -rqF 'fake mapping service' dist
}

check_ui_stack() {
  need_java
  need_node
  need_docker
  build_node
  # the working folder the node deploys from, made by this user before Docker makes it root's
  rm -rf ~/rail8-workspace
  mkdir -p ~/rail8-workspace
  # the users scenario makes the administrator with the emergency key; the development servers send the deploy account's
  # token, and the deploy scenario undeploys with it
  on_exit+=(stop_quickstart_node)
  start_quickstart_node ui-admin ui-deploy
  (cd ui && npm ci)
  need_chromium
  (cd ui && npm run e2e:stack)
}

check_mapping() {
  need_java
  cd mapping
  # the generator the build runs to merge the function families, and the ratchet's scripts, on the JDK
  scripts/test/function-families-test.sh
  scripts/test/function-families-refusals-test.sh
  scripts/test/ratchet-mutation-test.sh
  scripts/test/ratchet-moved-test.sh
  scripts/test/ratchet-bench-test.sh
  scripts/test/ratchet-baseline-test.sh
  scripts/test/gate-spec-bench-test.sh
  # the script tests that need no JDK; the ratchet's CI script and its wiring test stub java and gh
  scripts/test/pit-summary-test.sh
  scripts/test/gate-spec-default-test.sh
  scripts/test/gate-log-test.sh
  scripts/test/handover-test.sh
  scripts/test/ratchet-ci-test.sh
  scripts/test/ratchet-ci-wiring-test.sh
  # jacoco.skip: coverage floors and the ratchet run only in the nightly coverage job
  ../mvnw -B -Djacoco.skip=true verify
  # every file checks out byte-identical on Windows
  scripts/check-lf-checkout.sh
}

check_jq() {
  need_java
  cd jq
  # jacoco.skip: coverage is not measured on a change
  ../mvnw -B -Djacoco.skip=true verify
}

stop_stack() {
  if [ "$1" != 0 ]; then docker compose logs --no-color | tail -200 || true; fi
  docker compose --profile history --profile kafka down -v > /dev/null
}

check_stack() {
  need_java
  need_docker
  # the node reads this checkout as its package repository rail8, and refuses a shallow one
  [ "$(git rev-parse --is-shallow-repository)" = false ] || cannot "this checkout is shallow: git fetch --unshallow origin"
  build_node
  cd deploy/compose
  local key password start reply
  key=$("$root"/bin/rail8 key new)
  mask "$key"
  export RAIL8_ADMIN_TOKEN=$key
  export_secrets_key
  docker compose --profile history --profile kafka down -v --remove-orphans > /dev/null
  on_exit+=(stop_stack)
  docker compose up -d --build
  start=$(date +%s)
  until curl -sf localhost:8081/health > /dev/null; do
    if [ $(( $(date +%s) - start )) -ge 60 ]; then echo "::error::/health not green within 60 s of up"; exit 1; fi
    sleep 1
  done
  echo "seconds from up to /health green: $(( $(date +%s) - start ))"
  # the administrator and the deploy account, made through the admin API with the key; the administrator's password is
  # not kept
  password=$("$root"/bin/rail8 bootstrap --admin ci-admin --deploy-account ci-deploy --token-file "$tmp/deploy-token")
  mask "$password"
  RAIL8_TOKEN=$(cat "$tmp/deploy-token")
  mask "$RAIL8_TOKEN"
  export RAIL8_TOKEN
  docker compose run --rm deploy || { echo "::error::deploy failed"; docker compose logs rail8 | tail -50; exit 1; }
  curl -sf -H "Authorization: Bearer $RAIL8_TOKEN" localhost:8081/admin/packages | grep -q '"name":"demo"'
  # an invoice sent to the node's HTTP port, published on 8080, is answered by the partner
  reply=$(curl -sf -X POST --data-binary @"$root"/examples/demo/fixtures/sample-invoice.xml -H 'Content-Type: application/xml' localhost:8080/http/in)
  echo "$reply"
  echo "$reply" | grep -q '<PartnerInvoice number="4711" currency="CZK"'
}

show_ui_log() { if [ "$1" != 0 ]; then tail -100 "$tmp/ui.log" 2> /dev/null || true; fi; }

# The quickstart's first run, in its order, then what its reader does through the UI's server.
check_quickstart() {
  need_java
  need_node
  need_docker
  # the quickstart commits the demo in its working folder, and a runner's git has no identity of its own
  export GIT_AUTHOR_NAME='Rail8 CI' GIT_AUTHOR_EMAIL=ci@rail8.invalid GIT_COMMITTER_NAME='Rail8 CI' GIT_COMMITTER_EMAIL=ci@rail8.invalid
  build_node
  (cd ui && npm ci)
  rm -rf ~/rail8-workspace
  mkdir -p ~/rail8-workspace && cp -r examples/demo ~/rail8-workspace/demo
  cp -r mapping/corpus ~/rail8-workspace/mapping-corpus
  (cd ~/rail8-workspace/demo && git init -q -b main && echo '* -text' > .gitattributes && git add -A && git commit -qm 'The demo')
  on_exit+=(stop_quickstart_node show_ui_log)
  start_quickstart_node owner deploy
  bin/rail8 deploy demo HEAD --expect none
  # a check cannot log in through a browser, so the UI below runs in token mode as the deploy account; the administrator
  # gives it the operator role, which reads the messages
  local session
  session=$(curl -sf -X POST localhost:8081/admin/sessions -H 'Content-Type: application/json' \
    -d "$(jq -n --arg password "$admin_password" '{name: "owner", password: $password}')" | jq -r .session)
  mask "$session"
  curl -sf -X POST localhost:8081/admin/users/deploy/roles -H "Authorization: Bearer $session" -H 'Content-Type: application/json' \
    -d '{"add":["operator"],"remove":[]}' > /dev/null

  # the UI in token mode as the deploy account
  background "$tmp/ui.log" env RAIL8_WORKSPACE="$HOME/rail8-workspace" npm --prefix ui run dev
  local start
  start=$(date +%s)
  until curl -sf localhost:5173/ > /dev/null; do
    if [ $(( $(date +%s) - start )) -ge 90 ]; then echo "::error::the UI not answering within 90 s"; exit 1; fi
    sleep 2
  done

  # the Sec-Fetch-Site header stands in for the browser's own page in every call of the UI's server below
  # the mapping studio lists the corpus copy and opens a mapping through the node
  local listed code
  listed=$(curl -sf -H 'Sec-Fetch-Site: same-origin' localhost:5173/api/mappings || true)
  echo "$listed" | grep -q '"id":"mapping-corpus/mappings/order-id-copy"' \
    || { echo "::error::the studio does not list mapping-corpus/mappings/order-id-copy: $listed"; exit 1; }
  code=$(curl -s -o "$tmp/mapping.json" -D "$tmp/mapping.headers" -w '%{http_code}' -H 'Sec-Fetch-Site: same-origin' localhost:5173/api/mappings/mapping-corpus/mappings/order-id-copy)
  [ "$code" = 200 ] && grep -qi '^etag: "sha256:' "$tmp/mapping.headers" \
    || { echo "::error::opening order-id-copy through the node answered $code: $(cat "$tmp/mapping.json")"; exit 1; }

  # an invoice is sent in, found, listed and counted through the UI's server, which adds the token itself
  local reply found counted
  reply=$(curl -sf -X POST --data-binary @examples/demo/fixtures/sample-invoice.xml -H 'Content-Type: application/xml' localhost:8080/http/in)
  echo "$reply"
  echo "$reply" | grep -q '<PartnerInvoice number="4711" currency="CZK"'
  for _ in $(seq 1 30); do
    found=$(curl -sf -H 'Sec-Fetch-Site: same-origin' 'localhost:5173/admin/messages?key=invoiceId:4711' || true)
    echo "$found" | grep -q '"items":\[{"id":"' && break
    sleep 2
  done
  echo "$found" | grep -q '"items":\[{"id":"' || { echo "::error::the invoice was not found through the UI's /admin: $found"; exit 1; }
  # the list Messages opens on: the last hour, the invoice in it, completed, with its key
  listed=$(curl -sf -H 'Sec-Fetch-Site: same-origin' "localhost:5173/admin/messages?from=$(date -u -d '1 hour ago' +%FT%TZ)&to=$(date -u -d '1 minute' +%FT%TZ)" || true)
  echo "$listed"
  echo "$listed" | grep -q '"flow":"demo/invoice-sync","status":"completed"' && echo "$listed" | grep -q '"keys":{"invoiceId":"4711"}' \
    || { echo "::error::the invoice is not in the list of recent messages through the UI's /admin: $listed"; exit 1; }
  # the strip of counts above the list: the invoice among the completed ones, none failed
  counted=$(curl -sf -H 'Sec-Fetch-Site: same-origin' "localhost:5173/admin/message-counts?from=$(date -u -d '1 hour ago' +%FT%TZ)&to=$(date -u -d '1 minute' +%FT%TZ)" || true)
  echo "$counted"
  echo "$counted" | grep -Eq '"completed":[1-9]' && echo "$counted" | grep -q '"failed":0' \
    || { echo "::error::the invoice is not counted as completed through the UI's /admin: $counted"; exit 1; }

  # one message to each of the other demo flows, found through the UI's server
  ui() { curl -sf -H 'Sec-Fetch-Site: same-origin' "localhost:5173$1" || true; }
  # invoice-async answers 202 after the durable save
  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST --data-binary @examples/demo/fixtures/sample-invoice.xml -H 'Content-Type: application/xml' localhost:8080/http/invoice/async)
  [ "$code" = 202 ] || { echo "::error::invoice-async answered $code, not 202"; exit 1; }
  # sftp-invoice: a file dropped in the inbox is polled, saved and deleted
  docker compose cp examples/demo/fixtures/inbox/invoice-4711.xml sftp:/home/demo/inbox/
  # order-jq calls order-partner; the reply is the partner's echo of the mapped order
  local order flow
  order=$(curl -sf -X POST --data-binary @examples/demo/fixtures/sample-order.json -H 'Content-Type: application/json' localhost:8080/http/order)
  echo "$order"
  echo "$order" | grep -q '"orderId":42' || { echo "::error::order-jq did not answer the mapped order: $order"; exit 1; }
  # greet answers with the greeting its mapping makes
  local greeting
  greeting=$(curl -sf -X POST -H 'Content-Type: application/json' --data '{"name": "Ann", "city": "Brno"}' localhost:8080/http/greet)
  echo "$greeting"
  echo "$greeting" | grep -q '<Text>Hello, Ann</Text>' || { echo "::error::greet did not answer the greeting: $greeting"; exit 1; }
  for flow in invoice-async sftp-invoice order-jq order-partner greet; do
    for _ in $(seq 1 40); do
      found=$(ui "/admin/messages?from=$(date -u -d '1 hour ago' +%FT%TZ)&to=$(date -u -d '1 minute' +%FT%TZ)&flow=demo/$flow&status=completed")
      echo "$found" | grep -q '"items":\[{' && break
      sleep 2
    done
    echo "$found" | grep -q '"items":\[{' || { echo "::error::no completed message of demo/$flow through the UI's /admin: $found"; exit 1; }
  done

  # the demo flows are drawn from their files and the node's step types, saved and created, through the UI's server
  local flows file steps etag saved stale
  flows=$(ui /files/flows)
  echo "$flows"
  echo "$flows" | grep -q '"path":"demo/flows/invoice-sync.yaml","id":"invoice-sync"' \
    || { echo "::error::the Flows screen does not list the demo's invoice-sync: $flows"; exit 1; }
  file=$(ui /files/flows/demo/flows/invoice-sync.yaml)
  echo "$file" | grep -q '"id":"partner-domestic"' \
    || { echo "::error::invoice-sync's file comes without its package's endpoints: $file"; exit 1; }
  steps=$(ui /admin/steps)
  echo "$steps"
  echo "$steps" | grep -q '"type":"xslt"' || { echo "::error::the node does not list its xslt step at /admin/steps: $steps"; exit 1; }
  # Save of the flow's tab: its text sent back with the version read keeps the file and its version; a stale version is refused
  flow=localhost:5173/files/flows/demo/flows/invoice-sync.yaml
  etag=$(curl -sf -D - -o "$tmp/flow.json" -H 'Sec-Fetch-Site: same-origin' "$flow" | tr -d '\r' | sed -n 's/^etag: //Ip')
  jq '{text}' "$tmp/flow.json" > "$tmp/save.json"
  save() { curl -s -o /dev/null -D "$tmp/saved.headers" -w '%{http_code}' -X PUT -H 'Sec-Fetch-Site: same-origin' -H 'Content-Type: application/json' -H "If-Match: $1" --data-binary @"$tmp/save.json" "$flow"; }
  saved=$(save "$etag")
  [ "$saved" = 200 ] && grep -qiF "etag: $etag" "$tmp/saved.headers" \
    || { echo "::error::saving invoice-sync unchanged through the UI's server answered $saved, or a new version"; exit 1; }
  stale=$(save '"sha256-0"')
  [ "$stale" = 412 ] || { echo "::error::a save of invoice-sync with a stale version answered $stale, not 412"; exit 1; }
  cmp -s examples/demo/flows/invoice-sync.yaml ~/rail8-workspace/demo/flows/invoice-sync.yaml \
    || { echo "::error::the saves changed ~/rail8-workspace/demo/flows/invoice-sync.yaml"; exit 1; }
  # New flow, and the endpoint a call of a flow creates: a file that does not exist is written once, never over itself
  create() { curl -s -o /dev/null -w '%{http_code}' -X PUT -H 'Sec-Fetch-Site: same-origin' -H 'Content-Type: application/json' -H 'If-None-Match: *' --data-binary "$2" "localhost:5173/files/$1"; }
  local new_flow new_endpoint body first again
  new_flow=$(jq -n '{text: "schemaVersion: 1\nkind: flow\nid: audit\nversion: 0.1.0\nfrom:\n  endpoint: http-in\ndelivery:\n  mode: sync\nlimits:\n  maxBodyBytes: 1048576\nsteps:\n  - type: to\n    endpoint: partner-domestic\n"}')
  new_endpoint=$(jq -n '{text: "schemaVersion: 1\nkind: endpoint\nid: call-audit\nscheme: direct\ndirection: out\nconfig:\n  address: /audit\n"}')
  for file in flows/demo/flows/audit.yaml endpoints/demo/endpoints/call-audit.yaml; do
    body=$new_flow; [ "${file%%/*}" = endpoints ] && body=$new_endpoint
    first=$(create "$file" "$body"); again=$(create "$file" "$body")
    [ "$first" = 201 ] && [ "$again" = 412 ] \
      || { echo "::error::creating $file through the UI's server answered $first, then $again, not 201 and 412"; exit 1; }
  done
  grep -q '^id: audit$' ~/rail8-workspace/demo/flows/audit.yaml && grep -q '^id: call-audit$' ~/rail8-workspace/demo/endpoints/call-audit.yaml \
    || { echo "::error::the files created are not in ~/rail8-workspace/demo"; exit 1; }
  rm ~/rail8-workspace/demo/flows/audit.yaml ~/rail8-workspace/demo/endpoints/call-audit.yaml
}

check_adapter_kit() {
  need_java
  need_node
  need_docker
  command -v mvn > /dev/null 2>&1 || cannot "mvn is not installed: docs/ADAPTERS.md builds the adapter with it"
  # the commands of docs/ADAPTERS.md, in its order
  mvnw -q install -DskipTests -pl :rail8-cli -am
  (cd ui && npm ci)
  rm -rf ~/acme-adapter
  bin/rail8 new-adapter ~/acme-adapter --scheme acme --package com.acme.rail8
  mvn -B -ntp -q -f ~/acme-adapter/pom.xml verify
  bin/rail8 validate --plugins ~/acme-adapter/target/plugin ~/acme-adapter/package
  bin/rail8 test --plugins ~/acme-adapter/target/plugin ~/acme-adapter/package
  # run it with the UI, send a test message through it and find it; bin/run-adapter stops the UI, the partner and the node
  # and removes its Postgres when it is stopped
  on_exit+=(show_adapter_logs)
  background "$tmp/run-adapter.log" bin/run-adapter ~/acme-adapter
  local start components endpoints reply found
  start=$(date +%s)
  until grep -q 'Ctrl+C stops everything' "$tmp/run-adapter.log"; do
    if [ $(( $(date +%s) - start )) -ge 300 ]; then echo "::error::bin/run-adapter not running within 300 s"; exit 1; fi
    sleep 2
  done
  # the UI's server answers for the node; the Sec-Fetch-Site header stands in for the browser's own page
  ui() { curl -sf -H 'Sec-Fetch-Site: same-origin' "localhost:5173$1"; }
  components=$(ui /admin/components)
  echo "$components" | grep -q '"scheme":"acme"'
  endpoints=$(ui /files/endpoints)
  echo "$endpoints" | grep -q '"path":"package/endpoints/orders-in.yaml"'
  reply=$(curl -sf -X POST --data-binary @"$HOME/acme-adapter/package/fixtures/order.xml" -H 'Content-Type: application/xml' localhost:18090/acme/orders)
  echo "$reply"
  [ "$reply" = '<Order><Id>7</Id></Order>' ]
  for _ in $(seq 1 30); do
    found=$(ui '/admin/messages?key=orderId:7' || true)
    echo "$found" | grep -q '"items":\[{"id":"' && return 0
    sleep 2
  done
  echo "::error::the test message was not found through the UI's /admin: $found"; exit 1
}

show_adapter_logs() {
  if [ "$1" != 0 ]; then tail -100 "$tmp/run-adapter.log" ~/acme-adapter/target/run-adapter/*.log 2> /dev/null || true; fi
}

areas=' guard platform ui ui-stack mapping jq stack quickstart adapter-kit '
if [ "$#" -gt 1 ]; then
  several=1
  for a in "$@"; do [[ $areas == *" $a "* ]] || several=0; done
  if [ "$several" = 1 ]; then
    failed=0 not_run=0
    for a in "$@"; do
      status=0
      "$root/ci/check" "$a" || status=$?
      case $status in 0) ;; 3) not_run=1 ;; *) failed=1 ;; esac
    done
    if [ "$failed" = 1 ]; then exit 1; elif [ "$not_run" = 1 ]; then exit 3; fi
    exit 0
  fi
fi

area=${1:-help}
[ "$#" -gt 0 ] && shift
case $area in
  help|-h|--help) usage; exit 0 ;;
  *) [[ $areas == *" $area "* ]] || { usage >&2; exit 2; } ;;
esac

# What an area registers to run when it ends, passed or not: each function gets the exit status, and one that fails fails
# the area. The background processes started are stopped first, each with its process group.
on_exit=()
groups=()
finish() {
  local status=$? f g
  for g in "${groups[@]}"; do kill -TERM -- "-$g" 2> /dev/null || true; done
  for g in "${groups[@]}"; do for _ in $(seq 1 60); do kill -0 "$g" 2> /dev/null || break; sleep 1; done; done
  for f in "${on_exit[@]}"; do
    if ! "$f" "$status"; then
      echo "::error::$f failed" >&2
      if [ "$status" = 0 ]; then status=1; fi
    fi
  done
  rm -rf "$tmp"
  if [ "$status" = 0 ]; then echo "ci/check $area: passed"; elif [ "$status" != 3 ]; then echo "ci/check $area: FAILED ($status)" >&2; fi
  exit "$status"
}

export TZ=UTC
# A runner sets no _JAVA_OPTIONS, and every JVM prints a line on stderr for it; its flags move to JAVA_TOOL_OPTIONS, the
# variable the tests that start a JVM of their own take out of its environment.
if [ -n "${_JAVA_OPTIONS:-}" ]; then
  export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }$_JAVA_OPTIONS"
  unset _JAVA_OPTIONS
fi
tmp=$(mktemp -d)
trap finish EXIT
# git as on a runner: an empty global configuration and no system one
: > "$tmp/gitconfig"
export GIT_CONFIG_GLOBAL=$tmp/gitconfig GIT_CONFIG_NOSYSTEM=1
echo "ci/check $area: $(java -version 2>&1 | grep -m1 version || echo 'no java'); node $(node --version 2>/dev/null || echo missing); $(git --version)"

"check_${area//-/_}" "$@"
